{
  "compilerOptions": {
  "forceConsistentCasingInFileNames": true,
  "composite": true,
  "target": "ES2022",
  "lib": ["ES2022"],
  "module": "ESNext",
  "skipLibCheck": true,

  /* Bundler mode */
  "moduleResolution": "bundler",
  "isolatedModules": true,
  "moduleDetection": "force",

  /* Linting */
  "strict": true,
  "noUnusedLocals": true,
  "noUnusedParameters": true,
  "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "src/test/setup.ts", "**/*.test.tsx"]
}
